{
  "name": "toolbox-web-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-build-meta.mjs",
    "build:only": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "check": "npm run type-check && npm run build",
    "deploy": "node scripts/deploy.mjs",
    "deploy:dry": "node scripts/deploy.mjs --dry-run",
    "prune:hosting": "node scripts/prune-hosting.mjs",
    "prune:snapshots": "node scripts/prune-snapshots.mjs"
  },
  "dependencies": {
    "@cloudbase/js-sdk": "^3.7.1",
    "html2canvas": "^1.4.1",
    "vue": "^3.5.41",
    "vue-router": "^4.6.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vue-tsc": "^3.3.9"
  }
}
